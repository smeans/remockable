{
  "name": "remockable",
  "version": "0.1.0",
  "description": "A simple, zero-friction web service mockup server.",
  "type": "module",
  "bin": {
    "remockable": "bin/remockable.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/remockable.js",
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "cli",
    "command-line",
    "mock",
    "mock-server",
    "web-service",
    "api"
  ],
  "author": "Scott Means",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smeans/remockable.git"
  },
  "bugs": {
    "url": "https://github.com/smeans/remockable/issues"
  },
  "homepage": "https://github.com/smeans/remockable#readme",
  "dependencies": {
    "commander": "^12.1.0"
  }
}
